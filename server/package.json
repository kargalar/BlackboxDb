{
  "name": "blackbox-graphql-server",
  "version": "1.0.0",
  "description": "BlackBox GraphQL Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/resolvers/admin/prepareContentMedia.test.ts",
    "db:audit": "tsx scripts/database-audit.ts",
    "db:backup": "tsx scripts/database-backup.ts",
    "db:verify-backup": "tsx scripts/verify-database-backup.ts",
    "db:verify-behavior": "tsx scripts/verify-database-behavior.ts",
    "db:benchmark": "tsx scripts/benchmark-database.ts",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:check-types": "tsx prisma/check-content-types.ts",
    "script:fix-persons": "tsx src/scripts/fixPersonsTmdb.ts",
    "script:fix-tv-cast": "tsx src/scripts/fixTvCastAndCrew.ts",
    "script:recalculate-ratings": "tsx src/scripts/recalculateRatings.ts",
    "script:migrate-ratings-to-10": "tsx src/scripts/migrateRatingsToTenScale.ts",
    "script:cleanup-orphans": "tsx src/scripts/cleanupOrphans.ts",
    "script:migrate-content-images-to-local": "tsx src/scripts/migrateContentImagesToLocal.ts",
    "script:repair-data-integrity": "tsx src/scripts/repairDataIntegrity.ts",
    "script:normalize-theme-decades": "tsx src/scripts/normalizeThemeDecades.ts",
    "script:simplify-lookup-catalogs": "tsx src/scripts/simplifyLookupCatalogs.ts",
    "script:curate-lookups": "tsx src/scripts/curateLookups.ts",
    "script:fix-lists": "tsx src/scripts/fixLists.ts",
    "script:update-game-igdb": "tsx src/scripts/updateGameIgdbMetadata.ts",
    "script:fetch-popular-lists": "tsx src/scripts/fetchPopularContentLists.ts",
    "script:import-popular-lists": "tsx src/scripts/importPopularContentList.ts",
    "script:import-games-csv": "tsx src/scripts/importGamesFromCsv.ts",
    "script:import-movies-csv": "tsx src/scripts/importMoviesFromCsv.ts",
    "script:import-series-csv": "tsx src/scripts/importSeriesFromCsv.ts",
    "script:backfill-similarity-groups": "tsx src/scripts/backfillSimilarityGroups.ts",
    "script:verify-movie-franchise": "tsx src/scripts/verifyMovieFranchise.ts",
    "script:backfill-content-franchises": "tsx src/scripts/backfillContentFranchises.ts",
    "script:backfill-game-platforms": "tsx src/scripts/backfillGamePlatforms.ts",
    "script:backfill-content-status": "tsx src/scripts/backfillContentStatus.ts",
    "script:backfill-movie-tv-studios": "tsx src/scripts/backfillMovieTvStudios.ts",
    "script:backfill-game-engines": "tsx src/scripts/backfillGameEngines.ts",
    "db:verify-search": "tsx scripts/verify-content-search.ts"
  },
  "keywords": [
    "graphql",
    "apollo",
    "prisma",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express4": "^1.0.0",
    "@prisma/client": "^6.17.0",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.23.0",
    "graphql-type-json": "^0.3.2",
    "graphql-upload": "^16.0.2",
    "graphql-upload-minimal": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "prisma": "^6.17.0",
    "reflect-metadata": "^0.2.1",
    "type-graphql": "^2.0.0-rc.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/graphql-type-json": "^0.3.5",
    "@types/graphql-upload": "^17.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.19",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.6"
  }
}

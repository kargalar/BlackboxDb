model Discussion {
  id            Int                 @id @default(autoincrement())
  contentId     String?             @map("content_id") @db.VarChar(255)
  authorId      String              @map("author_id") @db.Uuid
  type          String              @default("discussion") @db.VarChar(20)
  isPublic      Boolean             @default(true) @map("is_public")
  isSpoiler     Boolean             @default(false) @map("is_spoiler")
  title         String?             @db.VarChar(255)
  description   String
  upvoteCount   Int                 @default(0) @map("upvote_count")
  downvoteCount Int                 @default(0) @map("downvote_count")
  commentCount  Int                 @default(0) @map("comment_count")
  isDeleted     Boolean             @default(false) @map("is_deleted")
  deletedAt     DateTime?           @map("deleted_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  author        AppUser             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       Content?            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  comments      DiscussionComment[]
  votes         DiscussionVote[]

  @@index([contentId])
  @@index([authorId])
  @@index([createdAt])
  @@index([type])
  @@index([isPublic])
  @@index([authorId, contentId, type, isDeleted, createdAt, id], map: "discussion_author_id_content_id_type_is_deleted_created_at_id_i")
  @@map("discussion")
}

model DiscussionComment {
  id            Int                        @id @default(autoincrement())
  discussionId  Int                        @map("discussion_id")
  authorId      String                     @map("author_id") @db.Uuid
  text          String
  parentId      Int?                       @map("parent_id")
  upvoteCount   Int                        @default(0) @map("upvote_count")
  downvoteCount Int                        @default(0) @map("downvote_count")
  isDeleted     Boolean                    @default(false) @map("is_deleted")
  deletedAt     DateTime?                  @map("deleted_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  author        AppUser                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion    Discussion                 @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent        DiscussionComment?         @relation("DiscussionCommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies       DiscussionComment[]        @relation("DiscussionCommentReplies")
  mentions      DiscussionCommentMention[]
  votes         DiscussionCommentVote[]

  @@index([discussionId])
  @@index([authorId])
  @@index([parentId])
  @@map("discussion_comment")
}


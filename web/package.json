{
  "name": "blackbox-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next dev",
    "build": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "start": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "export": "next build",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apollo/client": "4.0.7",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "apollo-upload-client": "19.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cropperjs": "1.6.2",
    "dotenv": "17.2.2",
    "graphql": "16.11.0",
    "jszip": "3.10.1",
    "lucide-react": "0.555.0",
    "next": "16.3.6",
    "next-intl": "4.12.0",
    "next-themes": "0.4.6",
    "papaparse": "5.5.3",
    "react": "19.2.1",
    "react-cropper": "2.3.3",
    "react-dom": "19.2.1",
    "react-hot-toast": "2.6.0",
    "recharts": "3.6.0",
    "rxjs": "7.8.2",
    "tailwind-merge": "^2.5.2",
    "tailwind-scrollbar-hide": "4.0.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20.14.10",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "^10.4.19",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "fast-check": "4.5.3",
    "jsdom": "28.1.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
